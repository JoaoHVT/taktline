# ==============================================================================
# Taktline — root ignore rules
# ==============================================================================
# Only source code and project assets belong under version control. Anything
# generated, machine-specific, secret, or reproducible from a build stays out.
# backend/.gitignore and frontend/.gitignore add rules scoped to those trees.
#
# Rule of thumb for anything new: if a tool produced it, it differs per
# developer, or it holds real business data — ignore it here.

# ── Secrets & credentials (never commit — highest priority) ──────────────────
# Private-key material anywhere in the repo. Public certs (*.crt/*.cer) are
# intentionally NOT ignored, so a public CA bundle can still be committed.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
id_rsa*
*.lic
secrets.json
credentials.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
venv/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
next-env.d.ts
coverage/

# ── Runtime business data (must never be versioned) ──────────────────────────
# Source workbooks and exports hold real production data; they are supplied to
# the running service, never stored in Git. See backend/README.md.
*.xlsx
*.xls
*.xlsm
backend/config.json
backend/session_state.json
backend/session_state.backup.json
backend/.job_state/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
*.log.err
logs/
backend/_*.log
backend/_*.log.err
frontend/.nextdev.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Caches & temporary files ─────────────────────────────────────────────────
.cache/
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.rej
*~

# ── AI / agent tooling (developer-local, not application code) ───────────────
.claude/
.agents/
.cursor/
.aider*
CLAUDE.md
AGENTS.md
skills-lock.json

# Generated knowledge graphs (graphify). Rebuildable from source with
# `/graphify .` — the graph.json/graph.html pair is several MB per tree.
graphify-out/

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Tests (local only — never committed) ──────────────────────────────────────
backend/tests/
frontend/tests/

# ── Database dumps ───────────────────────────────────────────────────────────
# Including the PLAIN format `pg_dump -f backup.sql` writes by default: it is the same dump
# with another extension, and *.dump/*.sql.gz alone let it through.
*.dump
*.sql.gz
*.sql

