# ==============================================================================
# Taktline frontend — environment template
# ==============================================================================
# Copy to `.env.local` (gitignored) if you need any of these. None is required:
# the defaults below are what a local `python run_demo.py` already uses.
#
# IMPORTANT: every NEXT_PUBLIC_* value is inlined into the JavaScript bundle and
# is therefore PUBLIC — readable by anyone who opens DevTools. Never put a secret
# behind this prefix. Nothing below is a secret, by design: all authorization
# happens server-side.

# ── Where the API is ─────────────────────────────────────────────────────────
# Used only when the app is NOT served single-origin. With NEXT_PUBLIC_SAME_ORIGIN
# set, the API base resolves to '' and every call goes out relative to the page.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Single origin ────────────────────────────────────────────────────────────
# "1" when Next itself forwards /api to the backend (see next.config.ts rewrites),
# which is how run_demo.py and the container both serve the app. The WebSocket is
# the exception: a Next rewrite does not forward a protocol upgrade, so it still
# uses NEXT_PUBLIC_WS_URL unless the page arrived through a proxy that does.
# NEXT_PUBLIC_SAME_ORIGIN=1

# Origins that terminate TLS in front of the app AND proxy the WebSocket upgrade.
# Comma-separated; only needed for a deployment behind such a proxy.
# NEXT_PUBLIC_ORIGINS=https://example.com

# ── Build ────────────────────────────────────────────────────────────────────
# BACKEND_ORIGIN is read at build/start time by next.config.ts to target the
# /api rewrite. Not a NEXT_PUBLIC_ value: it never reaches the browser.
# BACKEND_ORIGIN=http://127.0.0.1:8000
