# ==============================================================================
# OptVision frontend — environment template
# ==============================================================================
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
#
#   cp .env.example .env.local
#
# IMPORTANT: every NEXT_PUBLIC_* value is inlined into the JavaScript bundle and
# is therefore PUBLIC — visible to anyone who opens DevTools. Never put a secret
# behind this prefix. The values below are all non-secret by design; all real
# authorization happens server-side.

# ── Backend API ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket endpoint for live solver logs. Defaults to API_URL with ws/wss.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Autenticação ─────────────────────────────────────────────────────────────
# Não há mais nada para configurar aqui. O login deixou de ser Azure AD / Entra
# ID (MSAL, que precisava de tenant e client id no pacote) e passou a ser um
# formulário desta própria aplicação contra POST /api/auth/login. As três
# variáveis NEXT_PUBLIC_AZURE_* e NEXT_PUBLIC_ALLOWED_DOMAIN não são mais lidas
# por nada e podem ser removidas do .env.local.
