# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/

# ── Secrets / env (keep local, never commit) ────────────
.env
.env.*
!.env.example

# ── Runtime state & logs (regenerated at runtime) ───────
.job_state/
*.log
_srv.log*
_startup.log*

# ── OS cruft ────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Frontend assets: canonical copy lives in
#    ../frontend/public/imagens — not used by the backend,
#    so keep them out of the backend build/image. ─────────
imagens/

# ── Demo dataset ────────────────────────────────────────
# data/demo.sqlite IS committed: it is what the app reads, and it is generated,
# masked data with nothing real in it (tools/make_demo_data.py + tools/seed_demo_db.py,
# guarded by tools/check_no_real_names.py).
#
# data/demo_source.xlsx is NOT: the root `*.xlsx` rule covers it, and that is the right
# outcome — the workbook is a reproducible intermediate, and a blanket rule against
# committing spreadsheets is worth more than the convenience of this one.
data/demo_source.xlsx

# The working copy the process actually writes at runtime, if it lands here.
data/*.sqlite-wal
data/*.sqlite-shm
