# ==============================================================================
# OptVision backend — environment template
# ==============================================================================
# Fill in real values in a LOCAL file. NEVER commit it (`.env` is ignored).
# In production every value below is supplied through Railway's environment
# variables, not a file.
#
# ── WHERE THE REAL FILE GOES (changed) ───────────────────────────────────────
# NOT `backend/.env`. This working tree is inside a OneDrive-synced folder, so a
# .env next to the code replicates DATABASE_URL, ADMIN_PASSWORD and
# IMPORT_PASSWORD into a consumer cloud account — and into its version history,
# which editing the file later does not erase. Git was never the leak path
# (.gitignore has always blocked .env); the sync client was.
#
# Put it here instead — resolution order is in backend/env_paths.py:
#
#   %USERPROFILE%\.optvision\backend.env      (Windows, default)
#   ~/.optvision/backend.env                  (macOS/Linux, default)
#   $OPTVISION_ENV_FILE                       (explicit override, wins)
#
# `backend/.env` is still read LAST so an old checkout keeps working, but any
# file found there should be moved and its secrets rotated.
#
# Secrets marked (SECRET) must be rotated independently and must never appear in
# source, logs, tickets, or screenshots.

# ── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL on Supabase. MUST be the Session Pooler URL (IPv4) — the direct
# db.<ref>.supabase.co:5432 host is IPv6-only and is unreachable from Railway.
# See backend/database.py for the driver/SSL details.
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres   # (SECRET)

# Database TLS. Leave DB_SSL_VERIFY unset/1 to verify certificates.
# DB_SSL_VERIFY=1
# DB_SSL_ROOT_CERT=/path/to/ca.crt

# ── Autenticação própria (substituiu o Azure AD / Microsoft Entra ID) ────────
# A Entra ID saiu: a identidade agora mora no próprio banco (user_permissions.
# password_hash) e ESTE servidor emite o token de sessão, em vez de só validar o
# token de um terceiro. AZURE_TENANT_ID e AZURE_CLIENT_ID não são mais lidos por
# nada e podem ser removidos do arquivo real.
#
# AUTH_SECRET assina os tokens de sessão (HS256). É o segredo mais importante
# desta lista: quem o conhece consegue FORJAR uma sessão de qualquer usuário,
# inclusive de um administrador — o que é pior do que conhecer qualquer senha
# individual. Gere 32+ bytes aleatórios, por exemplo:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Se não for definido, o servidor deriva um segredo estável a partir de
# ADMIN_PASSWORD + IMPORT_PASSWORD + DATABASE_URL para não invalidar todas as
# sessões a cada reinício — e registra um erro no boot em produção. É um
# paliativo, não a configuração pretendida: trocar AUTH_SECRET invalida todas as
# sessões abertas, que é exatamente o que se quer numa resposta a incidente.
AUTH_SECRET=<random-48-bytes>           # (SECRET)

# Validade do token de sessão, em segundos (padrão 43200 = 12 h, um turno).
# AUTH_SESSION_TTL_SECONDS=43200

# Domínio exigido no CADASTRO (solicitação de acesso e criação por admin). Não é
# mais conferido a cada requisição: depois que a conta existe, ela é a
# identidade. Deixe vazio para aceitar qualquer domínio.
ALLOWED_DOMAIN=wabtec.com

# Senha fixa para as contas break-glass (SUPERADMIN_USERNAMES) na PRIMEIRA
# migração, em vez de uma senha aleatória escrita em ~/.optvision/
# senhas-iniciais.txt. É o caminho de recuperação para deploys onde esse arquivo
# não é legível (container efêmero). Remova depois de entrar e trocar a senha.
# SUPERADMIN_BOOTSTRAP_PASSWORD=<strong-random-value>   # (SECRET)

# ── Second factors (required in production) ──────────────────────────────────
# Two SEPARATE secrets, rotated independently — do not set them to the same value.
#   ADMIN_PASSWORD  — the admin "unlock" second factor (short-lived grant) that
#                     gates sensitive reads/exports/user management.
#   IMPORT_PASSWORD — the shared application password prompted per import,
#                     per override-save, and per dataset download.
# Both fail CLOSED in production: if unset, the operations they gate return 503.
ADMIN_PASSWORD=<strong-random-value>    # (SECRET)
IMPORT_PASSWORD=<strong-random-value>   # (SECRET)

# ── Environment / CORS ───────────────────────────────────────────────────────
# "production" enables fail-closed behaviour: /docs returns 404, unset passwords
# refuse the operation instead of allowing it, error details are scrubbed.
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# ── API docs (optional; production only) ─────────────────────────────────────
# /docs and /redoc are 404 in production. Set DOCS_ALLOW_IN_PROD=1 plus basic-auth
# credentials to expose them temporarily. Leave unset unless actively debugging.
# DOCS_ALLOW_IN_PROD=1
# DOCS_USER=<user>
# DOCS_PASSWORD=<strong-random-value>   # (SECRET)

# ── Break-glass admin (optional) ─────────────────────────────────────────────
# Comma-separated usernames (the part before @) that always retain admin, so a
# misconfigured role table cannot lock everyone out. Defaults to a single
# built-in account; set explicitly to make the list auditable per environment.
# SUPERADMIN_USERNAMES=joao.voss

# ── Tuning (optional; defaults are sensible) ─────────────────────────────────
# UPLOAD_MAX_BYTES=41943040       # 40 MB ceiling per uploaded workbook (all 4 upload routes).
#                                 # Enforced by the read loop, not just Content-Length, so a
#                                 # chunked upload is bounded too. Raise only if a genuine base
#                                 # outgrows it — the largest imported today is a few MB.
# DB_VIEW_MAX_ROWS=20000          # max rows returned to the in-app dataset grid
# MAX_RETAINED_JOBS=50            # solver jobs kept before pruning
# SCENARIO_CACHE_MAX_ITEMS=8      # in-memory scenario cache bounds
# SCENARIO_CACHE_MAX_BYTES=268435456
# DISCRETIZADO_SPLIT_READ=1
# LOCAL_IP=                       # dev-only: LAN IP for the dev launcher

# ── Como esta máquina serve a aplicação ──────────────────────────────────────
# APP_MODE=production | dev
#
# production  → o frontend roda `next build` + `next start` e o backend sobe SEM o
#               recarregador de arquivos do uvicorn. É o modo do host.
# dev         → `next dev` (com HMR) e uvicorn com reload. É o modo da máquina de
#               desenvolvimento.
#
# O PADRÃO É PRODUCTION em qualquer máquina que defina PUBLIC_ORIGIN, e a máquina de
# desenvolvimento é que declara APP_MODE=dev para optar por sair. O padrão inverso
# deixaria um host esquecido servindo `next dev` para a rede — e `next dev` publica
# /__nextjs_launch-editor, que faz o HOST abrir um arquivo no editor sem autenticação
# nenhuma, além de afrouxar a CSP ('unsafe-eval' em script-src) e emitir source maps
# com o TypeScript original. Ver backend/frontend_serve.py.
# APP_MODE=dev
