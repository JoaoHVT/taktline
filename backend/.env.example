# ==============================================================================
# Taktline backend — environment template
# ==============================================================================
# EVERY VALUE BELOW IS OPTIONAL. The demo runs with no .env at all: the database
# ships with the code, the session secret is generated per boot, and there is no
# external service to point at.
#
# To use one anyway, copy this file to `.env` next to it (it is gitignored), or
# point TAKTLINE_ENV_FILE at a file elsewhere — resolution order is in
# backend/env_paths.py.

# ── Database ─────────────────────────────────────────────────────────────────
# By default the app copies backend/data/demo.sqlite to a throwaway file at
# startup and works on the copy, so nothing a visitor does survives a restart.
# The two variables below move either end of that copy; DATABASE_URL overrides
# the whole arrangement and is what points the app at a database of your own.
#
# DEMO_DB_SEED=backend/data/demo.sqlite   # the read-only file that ships
# DEMO_DB_PATH=/tmp/taktline-demo.sqlite  # the working copy actually written to
# DATABASE_URL=sqlite:///absolute/path/to/your.sqlite

# ── Session ──────────────────────────────────────────────────────────────────
# AUTH_SECRET signs the HS256 session tokens. It is the most important value
# here: anyone who knows it can FORGE a session for any account, which is worse
# than knowing any individual password.
#
# Left unset, a random secret is generated at every boot. That is the right
# default for a demo — a restart simply asks for the login again — and it is why
# there is no fallback derived from other variables, which would be both stable
# and guessable. Set it only when sessions must survive a restart:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# AUTH_SECRET=<random-48-bytes>              # (SECRET)
# AUTH_SESSION_TTL_SECONDS=43200             # 12 h; how long a session lasts

# Domain appended to a bare username when composing an account's e-mail. Cosmetic
# in this build: nothing is checked against it, because the one account is seeded
# rather than registered.
# ALLOWED_DOMAIN=example.com

# ── Second factor ────────────────────────────────────────────────────────────
# The admin "unlock" grant. No route in this build requires one — the surfaces
# that did were removed — so this exists only for the machinery that outlived
# them. Leave it unset.
# ADMIN_PASSWORD=<strong-random-value>       # (SECRET)

# ── Environment ──────────────────────────────────────────────────────────────
# "production" enables fail-closed behaviour: /docs returns 404 and error details
# are scrubbed from responses. The container sets this.
# ENVIRONMENT=development
# FRONTEND_URL=http://localhost:3000
# PORT=8000

# ── API docs (optional; production only) ─────────────────────────────────────
# /docs and /redoc return 404 in production. Set all three to expose them behind
# basic auth temporarily. Leave unset unless actively debugging.
# DOCS_ALLOW_IN_PROD=1
# DOCS_USER=<user>
# DOCS_PASSWORD=<strong-random-value>        # (SECRET)

# ── Tuning ───────────────────────────────────────────────────────────────────
# MAX_RETAINED_JOBS=50            # finished solver jobs kept in memory before pruning
# DISCRETIZADO_SPLIT_READ=auto    # auto | on | off — read demand from the split
#                                 # tables (itens_rout + plano_prod) or the flat one
